{% extends 'base.html.twig' %}

{% block title %}Résultat de la recherche " {{ query }} "{% endblock %}

{% block body %}
<style> main, section, .search-results { background: aquamarine !important; } </style>
<div class="search-results">
    {% if query %}
        <h3>{{ query }} : {{ results|filter(results => results|length > 0)|length }} références{{ results|filter(v => v|length > 0)|length > 1 ? 's' }} trouvée(s){{ results|filter(v => v|length > 0)|length > 1 ? 'es' }}</h3>
            
        {% if results.ressources|length > 0 %}
            <section>
                <h4>ressources ({{ results.ressources|length }})</h4>
                {% for ressource in results.ressources %}
                    <div class="search-result">
                        <a href="{{ path('app_ressource_show', {'id': ressource.id}) }}">{{ ressource.nom }}</a>
                    </div>
                {% endfor %}
            </section>
        {% endif %}
        {% if results.produits|length > 0 %}
            <section>
                <h4>Produits ({{ results.produits|length }})</h4>
                {% for produit in results.produits %}
                    <div class="search-result">
                        <a href="{{ path('app_produit_show', {'id': produit.id}) }}">{{ produit.nom }}</a>
                    </div>
                {% endfor %}
            </section>
        {% endif %}

        {% if results.producteurices|length > 0 %}
            <section>
                <h4>producteurices ({{ results.producteurices|length }})</h4>
                {% for producteurice in results.producteurices %}
                    <div class="search-result">
                        <a href="{{ path('app_producteurice_show', {'id': producteurice.id}) }}">{{ producteurice.nom }}</a>
                    </div>
                {% endfor %}
            </section>
        {% endif %}

        {% if results.recettes|length > 0 %}
            <section>
                <h4>Recettes ({{ results.recettes|length }})</h4>
                {% for recette in results.recettes %}
                    <div class="search-result">
                        <a href="{{ path('app_recette_show', {'id': recette.id}) }}">{{ recette.titre }}</a>
                    </div>
                {% endfor %}
            </section>
        {% endif %}
        {% if results.poles|length > 0 %}
            <section>
                <h4>poles ({{ results.poles|length }})</h4>
                {% for pole in results.poles %}
                    <div class="search-result">
                        <a href="{{ path('app_pole_show', {'id': pole.id}) }}">{{ pole.titre }}</a>
                    </div>
                {% endfor %}
            </section>
        {% endif %}
    {% else %}
        <h4>Tape un mot dans la recherche !</h4>
    {% endif %}
</div>
{% endblock %}
