{# theme pour les form avec form.css 
+ rajout dans config/packages/twig.yaml: 
twig:
form_themes:
        - 'form/form_theme.html.twig'#}


{# row #}
{% block form_row %}
    <div class="form-field">
        {{ form_label(form) }}
        {{ form_widget(form) }}
        {{ form_errors(form) }}
    </div>
{% endblock %}

{# Label #}
{% block form_label %}
    <label{% with { attr: attr|merge({ class: (attr.class|default('') ~ ' form-label')|trim }) } %}{{ block('attributes') }}{% endwith %}>
        {{ label|trans({}, translation_domain) }}
    </label>
{% endblock %}

{# Widget (input) #}
{% block form_widget_simple %}
    {% set invalid = (not compound and not valid) ? 'is-invalid' : '' %}
    {% set classes = (attr.class|default('') ~ ' form-input ' ~ invalid)|trim %}
    <input
        type="{{ type|default('text') }}"
        {{ block('widget_attributes') }}
        value="{{ value }}"
        class="{{ classes }}"
    >
{% endblock %}



