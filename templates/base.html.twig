<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        
{# font INTER google      
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">
#}
        <link rel="preconnect" href="https://rsms.me/">
        <link rel="stylesheet" href="https://rsms.me/inter/inter.css">


        {% block javascripts %}
            <script>
                {# oeil password #}
                function togglePasswordVisibility(inputId, button) {
                    const input = document.getElementById(inputId);
                    const img = button.querySelector('img');

                    if (input.type === "password") {
                        input.type = "text";
                        img.src = "/images/oeilFerme.webp";
                    } else {
                        input.type = "password";
                        img.src = "/images/oeilOuvert.webp";
                    }
                }

                {# pour ajout recette : ouverture de modale login si user pas connecté #}
      {#          function openLoginModalWithRedirect() {
                    // Sauvegarde l'URL cible dans la session
                    sessionStorage.setItem('login_redirect', '/ajout/recette');
                    window.location.href = '/login';
                }

                function openLoginModal() {
                    window.location.href = '/login';
                }.  #}

function showLoginError() {
    // Supprime anciens messages
    document.querySelectorAll('.login-error').forEach(el => el.classList.remove('show'));
    
    // Crée le message
    const pill = event.target.closest('.pill');
    let errorMsg = pill.querySelector('.login-error');
    
    if (!errorMsg) {
        errorMsg = document.createElement('div');
        errorMsg.className = 'login-error';
        errorMsg.textContent = 'E R R O R [ connecte-toi pour ajouter la recette ]';
        pill.parentNode.classList.add('relative');
        pill.parentNode.appendChild(errorMsg);
    }
    
    errorMsg.classList.add('show');
    
    // Cache après 3s
    setTimeout(() => errorMsg.classList.remove('show'), 4000);
}

function openLoginModal() {
    window.location.href = '/login';
}



{#.  function openLoginModalWithRedirect() {
    window.location.href = '/login?return_url=ajout/recette';
}       #}



            </script>
        {% endblock %}
        
    </head>
    
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('styles/pills.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/header.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/footer.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/nav_page.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/form.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/recette.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">


        {# form.css seulement sur pages avec forms #}
        {% if block('form_styles') is defined %}
            <link rel="stylesheet" href="{{ asset('styles/form.css') }}">
        {% endif %}
    {% endblock %}
    
    <body>
        {% include 'partials/_header.html.twig' %}

        <main>
            {% block body %}
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="flash-message flash-{{ label }}">
                            {{ message }}
                            <button type="button" class="flash-close" aria-label="Fermer">&times;</button>
                        </div>
                    {% endfor %}
                {% endfor %}

                {# Ici viendra le contenu spécifique à chaque page #}
            {% endblock %}
        </main>

        {% include 'partials/_footer.html.twig' %}
    </body>
</html>


