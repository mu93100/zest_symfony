{% extends 'modal_base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block modal_title %}connexion{% endblock %}

{% block modal_error %}
    {% if error %}
        <div class="modal-error">[ email ou mot de passe incorrect ]</div>
    {% endif %}
{% endblock %}

{% block modal_body %}
     {# close modale et overlay #}
     <button type="button" class="close" onclick="document.querySelector('.modal-overlay').remove();">✕</button>

    <form action="{{ path('app_login') }}" method="post">

        <div class="form-field">
            <label for="inputEmail">Email</label>
            <input 
                type="email" 
                id="inputEmail" 
                name="_username" 
                value="{{ last_username }}" 
                required 
                autocomplete="email"
                class="form-input"
            >
        </div>

        {% include 'components/password_field.html.twig' with {
            id: 'inputPassword',
            field_name: '_password',
            label: 'Mot de passe',
            autocomplete: 'current-password',
            hasError: error is defined and error
        } %}



        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button type="submit" class="form-submit">se connecter</button>

        <div class="form-links">
            <a href="{{ path('app_forgot_password_request') }}">mot de passe oublié</a>
        </div>

    </form>
{% endblock %}

