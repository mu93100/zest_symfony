{% extends 'base.html.twig' %}

{% block title %}adhesion{% endblock %}

{% block body %}
	<main class="form-container">
		<h1>adhésion saison {{ saison.nom }}</h1>

		{# affichage des messages flash #}
		{% for message in app.flashes('success') %}
			<div class="alert alert-success">
				{{ message|raw }}
			</div>
		{% endfor %}

		{# affichage du nom mail groupe du user connecté #}
		{% if app.user %} <p>[ {{ app.user.prenom }} ({{ app.user.email }}) du groupe {{ app.user.groupe.nom }} ]</p>
		{% else %}
			<p>E R R O R   [ connectes-toi pour l'adhesion {{ saison.nom }} ]</p>
		{% endif %}


		{{ form_errors(adhesionForm) }}
		{{ form_start(adhesionForm) }}

		<div class="form-section">
			<h3>modifier mes infos groupe</h3>
			{# <a href="https://umap.openstreetmap.fr/fr/map/cartographie-zest-2024_1119693" target="_blank">
				<img src="{{ asset('images/map.webp') }}" alt="Plan d'accès">
			</a> #}
			{{ form_row(adhesionForm.changeGroupe) }}
			{{ form_row(adhesionForm.nouveauGroupe) }}
			{{ form_row(adhesionForm.adresseDistribNouveau) }}
			{{ form_row(adhesionForm.codePostalNouveau) }}
			{{ form_row(adhesionForm.villeNouveau) }}
			<h3>à remplir si je suis référent.e</h3>
			<div class="form-check">
				{{ form_widget(adhesionForm.isReferent) }}
				{{ form_label(adhesionForm.isReferent) }}
			</div>
			<div class="form-check">
				{{ form_widget(adhesionForm.isOpen) }}
				{{ form_label(adhesionForm.isOpen) }}
			</div>
			{{ form_row(adhesionForm.adresseDistrib) }}
			{{ form_row(adhesionForm.codePostal) }}
			{{ form_row(adhesionForm.ville) }}
		</div>
		<div class="form-section">
			<h3>motivations et attentes</h3>
			<div class="form-check">
				{{ form_label(adhesionForm.motivations) }}
				{{ form_widget(adhesionForm.motivations) }}
			</div>
			{{ form_row(adhesionForm.attentesTexte) }}

			<h3>participation et disponibilités</h3>
			<div class="form-check">
				{{ form_label(adhesionForm.dispos) }}
				{{ form_widget(adhesionForm.dispos) }}	
			</div>
			{{ form_row(adhesionForm.competencesTexte) }}
			<div class="form-check">
				{{ form_widget(adhesionForm.poles) }}
				{{ form_label(adhesionForm.poles) }}
			</div>			
		</div>
		<div class="form-section">
			<h3>informations importantes</h3>
			<p>
				<span>Adhésion annuelle :</span>
				10€ par foyer - adhésion solidaire : 5€ - adhésion de soutien : à partir de 15€<br>
				<span>Engagement :</span>
				Participation au fonctionnement de l'asso et aux réunions (AG, réunions des référents, ...)<br>
				<span>Fonctionnement :</span>
				7 à 8 commandes annuelles - livraisons le mercredi matin<br>
				<span>Lieu de livraison :</span>
				On Sème Tous - 102 Rue Hoche, 93100 Montreuil</p>
		</div>
		<div class="form-section agree_section">
			<label class="agree_item">
				{{ form_widget(adhesionForm.agree_fonctionnement) }}
				{{ form_label(adhesionForm.agree_fonctionnement) }}
			</label>
			<div class="adhesion_details">
				<label class="agree_item">
					{{ form_widget(adhesionForm.agree_adhesion) }}
					{{ form_label(adhesionForm.agree_adhesion) }}
				</label>
			</div>

			{{ form_row(adhesionForm.montantAdhesion) }}


		</div>
		<div>
			{# Réservé admin si tu veux : 
			{{ form_row(adhesionForm.paiementValide) }}#}

			<button type="submit" class="form-submit">j’adhère pour la saison</button>
			{{ form_end(adhesionForm) }}
		</div>
	</div>


	<script>
		document.addEventListener('DOMContentLoaded', function () {
		const changeCheckbox = document.querySelector('.change-groupe-checkbox');
		const nouveauInput = document.querySelector('.nouveau-groupe-input');

		if (! changeCheckbox || ! nouveauInput) {
		return;
		}

		changeCheckbox.addEventListener('change', function () {
			if (this.checked) {
			nouveauInput.style.display = 'block';
			nouveauInput.required = true;
			} else {
			nouveauInput.style.display = 'none';
			nouveauInput.required = false;
			}
		});
		});
	</script>
{% endblock %}
