				{{ form_row(adhesionForm.email) }}
				{{ form_row(adhesionForm.plainPassword, { label: 'Mot de Passe'}) }}
				{{ form_row(adhesionForm.agreeTerms) }}
		
				<button type="submit" class="btn">se connecter</button>
				{{ form_end(adhesionForm) }} #}