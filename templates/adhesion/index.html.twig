{% extends 'base.html.twig' %}

{% block title %}adhesion{% endblock %}


{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>adhésion</h1>

     {{ form_errors(adhesionForm) }}

    {{ form_start(adhesionForm) }}
        {{ form_row(adhesionForm.email) }}
        {{ form_row(adhesionForm.groupe) }}
        {{ form_row(adhesionForm.nouveauGroupe) }}
        {{ form_row(adhesionForm.isReferent) }}
        {{ form_row(adhesionForm.isOpen) }}
        {{ form_row(adhesionForm.motivation) }}
        {{ form_row(adhesionForm.participationDispo) }}
        {{ form_row(adhesionForm.pole) }}
        {{ form_row(adhesionForm.competences) }}
        {{ form_row(adhesionForm.engagement) }}
        {{ form_row(adhesionForm.paiement) }}
        {{ form_row(adhesionForm.adhesion) }}
        {{ form_row(adhesionForm.infos) }}
        {{ form_row(adhesionForm.paiement) }}

        {{ form_row(adhesionForm.agree_fonctionnement_participation) }}
        {{ form_row(adhesionForm.agree_rgpd) }}
        {{ form_row(adhesionForm.agree_infos_mail) }}
        

        <button type="submit" class="btn">adhérer</button>
    {{ form_end(adhesionForm) }}
</div>
{% endblock %} 

