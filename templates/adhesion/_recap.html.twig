<div class="adhesion-recap" id="adhesion-recap">
    <button type="button" class="close" onclick="document.getElementById('adhesion-recap').remove();">
        ✕
    </button>
    {# <button type="button" class="adhesion-recap-close" onclick="document.getElementById('adhesion-recap').remove();">
        ✕
    </button> #}

    <h4>[ A D H É S I O N   E N R E G I S T R É E ]</h4>
    <p>Merci de la régler par virement sous 15 jours</p>
    <ul>
        <li><strong>Prénom :</strong> {{ user.prenom }}</li>
        <li><strong>Email :</strong> {{ user.email }}</li>
        <li><strong>Mon adhesion :</strong> {{ montantAdhesion.libelle ?? '—' }} €</li>
        <li><strong>Mon groupe :</strong> {{ groupe.nom }}</li>
        <li><strong>Adresse de distibution du groupe:</strong> {{ groupe.adresseDistrib ?? '—' }}</li>
        <li><strong>Ville :</strong> {{ groupe.ville ?? '—' }}</li>
        {% if user.groupeReferent %}
            <li><strong>Je suis référent·e de mon groupe</strong></li>
        {% endif %}
        {% if groupe.isOpen %}
            <li>
                <strong>Mon groupe peut accueillir de nouvelleaux adhérent·e.s</strong>
                <img src="{{ asset('images/isOpen.png') }}" alt="Groupe ouvert">
            </li>
        {% endif %}
    </ul>
</div>
