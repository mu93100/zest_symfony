{% extends 'base.html.twig' %}

{% block body %}
<section class="recette-container">

    {% set photo = recette.medias|filter(m => m.role == 'photo_principale')|first %}
    {% if photo %}
        <img src="{{ asset('uploads/media/' ~ photo.nomFichier) }}" alt="{{ photo.description }}" class="recette-photo">
    {% endif %}

    <h1>{{ recette.titre }}</h1>

    <p class="meta">
        Publiée le {{ recette.datePublication|date('d/m/Y') }} par {{ recette.auteurice.nom }}
        — pour {{ recette.nombreMangeurs }} mangeurs
    </p>

    <h3>Ingrédients</h3>
    <p>{{ recette.ingredients }}</p>

    <h3>Description</h3>
    <p>{{ recette.description|nl2br }}</p>

    <h3>Produits utilisés</h3>
    <ul>
        {% for produit in recette.produit %}
            <li>{{ produit.nom }}</li>
        {% endfor %}
    </ul>

</section>
{% endblock %}
