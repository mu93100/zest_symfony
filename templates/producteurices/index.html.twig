{% extends 'base.html.twig' %}

{% block title %}les producteur.ices{% endblock %}

{% block body %}
<div class ="container-producteurice">
    <h1 style="color: black;">producteur.ices</h1>

    {% for producteurice in producteurices %}
    <div class="producteurice" style="margin-bottom:50px;">
        <h3>{{ producteurice.nom }}</h3>

        <p>{{ producteurice.description|striptags|nl2br }}</p>

        {# ============================
           LOGO
           ============================ #}
        <h5>[ logo ]</h5>

        {% set logo = producteurice.medias|filter(m => m.role == 'logo') %}

        {% if logo is not empty %}
            <div class="logo-producteurice">
                {% for media in logo %}
                    <img src="{{ vich_uploader_asset(media, 'file') }}"
                         alt=""
                         style="max-width:300px; margin:10px 0;">
                {% endfor %}
            </div>
        {% else %}
            <p>Aucun logo</p>
        {% endif %}
        
        {# ============================
           PHOTO PRINCIPALE
           ============================ #}
        <h5>[ Photo principale ]</h5>

        {% set photo_principale = producteurice.medias|filter(m => m.role == 'photo_principale') %}

        {% if photo_principale is not empty %}
            <div class="photo-principale">
                {% for media in photo_principale %}
                    <img src="{{ vich_uploader_asset(media, 'file') }}"
                         alt=""
                         style="max-width:300px; margin:10px 0;">
                {% endfor %}
            </div>
        {% else %}
            <p>Aucune photo principale</p>
        {% endif %}

        {# ============================
           PHOTOS SUPPLÉMENTAIRES
           ============================ #}
        <h5>[ Photos supplémentaires ]</h5>

        {% set photos_supp = producteurice.medias|filter(m => m.role == 'photo_supplementaire') %}

        {% if photos_supp is not empty %}
            <div class="photos-supplementaires" style="display:flex; flex-wrap:wrap; gap:10px;">
                {% for media in photos_supp %}
                    <img src="{{ vich_uploader_asset(media, 'file') }}"
                         alt=""
                         style="max-width:150px;">
                {% endfor %}
            </div>
        {% else %}
            <p>Aucune photo supplémentaire</p>
        {% endif %}

        <hr>

        {# ============================
           SITE WEB + LIEN PRODUITS
           ============================ #}
        <h5>Informations</h5>

        <ul>
            <li>
                <strong>Site web :</strong>
                <a href="{{ producteurice.site }}" target="_blank">{{ producteurice.site }}</a>
            </li>

            {% if producteurice.lienProduits %}
                <li>
                    <strong>Produits :</strong>
                    <a href="{{ producteurice.lienProduits }}" target="_blank">
                        Voir les produits
                    </a>
                </li>
            {% endif %}
        </ul>

        <hr>

        {# ============================
           PRODUITS ASSOCIÉS
           ============================ #}
        <h5>Produits associés</h5>

        {% if producteurice.produits is empty %}
            <p>Aucun produit associé</p>
        {% else %}
            <ul>
                {% for produit in producteurice.produits %}
                    <li>{{ produit.nom }}</li>
                {% endfor %}
            </ul>
        {% endif %}

        <hr>

        {# ============================
           FICHIERS (PDF, docs…)
           ============================ #}
        <h5>Fichiers associés</h5>

        {% set fichiers = producteurice.medias|filter(m => m.role == 'fichier') %}

        {% if fichiers is empty %}
            <p>Aucun fichier associé</p>
        {% else %}
            <ul>
                {% for media in fichiers %}
                    <li>
                        <a href="{{ asset('uploads/medias/' ~ media.nomFichier) }}" download>
                            {{ media.nomFichier }}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    <hr>
    {% else %}
        <p>Aucun.ne producteur.ice trouvé.e</p>
    {% endfor %}   
    </div>
</div>
{% endblock %}
