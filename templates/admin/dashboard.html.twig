{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content %}
    <div class="dashboard-container">
        <h1>Dashboard CORTO-ZEST</h1>

        <form method="get" action="{{ path('admin') }}">
    <label for="saison">Choisir une saison :</label>
    <select name="saison" id="saison" onchange="this.form.submit()">
        {% for saison in saisons %}
            <option value="{{ saison.id }}"
                {% if saisonEnCours and saison.id == saisonEnCours.id %} selected {% endif %}>
                {{ saison.nom }}
            </option>
        {% endfor %}
    </select>
</form>


        {% if saisonEnCours %}
            <h1>Nombre d’adhésions {{ saisonEnCours.nom }} : {{ nbAdhesions }}</h1>
        {% else %}
            <p>Aucune saison trouvée.</p>
        {% endif %}
    </div>
{% endblock %}
