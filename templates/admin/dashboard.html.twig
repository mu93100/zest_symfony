{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content %}
	{#<div class="dashboard-container" style="padding: 20px; display: flex; flex-direction: column; gap: 20px;">
		<h1>Dashboard CORTO-ZEST</h1>

	{% if saisonEnCours %}
		<p>Saison <strong>{{ saisonEnCours.nom }}</strong></p>	
	{% else %}
		<p>Aucune saison trouvée.</p>
	{% endif %}
	</div>#}

	<div class="dashboard-container" style="color: #00ff9d; font-size: 5rem; font-weight: 800; line-height: 1;padding: 20px; display: flex; flex-direction: column; gap: 20px;">
		<h1 style="color: #00ff9d; font-size: 5rem; font-weight: 800; line-height: 1;">Dashboard CORTO-ZEST</h1>

		<form method="get" action="{{ path('admin') }}">
			<label style=" font-weight: bolder;" for="saison">Choisir une saison :</label>
			<select name="saison" id="saison">
				{% for saison in saisons %}
				<option value="{{ saison.id }}" {% if saisonEnCours and saison.id == saisonEnCours.id %} selected {% endif %}>
					{{ saison.nom }}
				</option>
			{% endfor %}
		</select>
		<button style="color: #00ff9d;" type="submit">Afficher</button>
	</form>

	{% if saisonEnCours %}
		<p>Saison sélectionnée :
			<strong>{{ saisonEnCours.nom }}</strong>
		</p>
		<p>Nombre d’adhésions :
			<strong>{{ nbAdhesions }}</strong>
		</p>
	{% else %}
		<p>Aucune saison trouvée.</p>
	{% endif %}
	</div>		
{% endblock %}
