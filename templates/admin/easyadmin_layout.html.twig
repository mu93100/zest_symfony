{# {% extends '@EasyAdmin/layout.html.twig' %}

{% block content_header %}
    {{ parent() }}

    {% if saisons is not empty %}
        <form method="get" action="{{ app.request.uri }}" style="margin-top:1rem; background-color: #00ff9d;padding:1rem;border-radius:0.5rem;">
            <label for="saison">Saison :</label>
            <select id="saison" name="saison" onchange="this.form.submit()">
                {% for saison in saisons %}
                    <option value="{{ saison.id }}"
                        {% if saisonEnCours and saison.id == saisonEnCours.id %}selected{% endif %}>
                        {{ saison.nom }}
                    </option>
                {% endfor %}
            </select>
        </form>
    {% else %}
        <p style="margin-top:1rem;">Aucune saison trouvée</p>
    {% endif %}

    {% form_theme form 'admin/fields/produits_flex_row.html.twig' %}

{% form_theme form 'admin/fields/produits_flex_row.html.twig' %} #}





