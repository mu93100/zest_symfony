{% if field.value is iterable %}
    <div style="display:flex; flex-direction: row; gap:0.2rem;">
        {% for filename in field.value %}
            <img src="/uploads/medias/{{ filename }}" style="height:2rem; border-radius:0.02rem;">
        {% endfor %}
    </div>
{% else %}
    <span style="color:#888;">Aucune photo</span>
{% endif %}
