{% extends 'base.html.twig' %}

{% block title %}les produits{% endblock %}

{% block body %}
<div class="container-produit">
    <h1 style="color: black;">les produits</h1>

    {% for produit in produits %}
        <div class="produit" style="margin-bottom:7rem;">
            <h2 >{{ produit.nom }}</h2>
            {# ============================
               PHOTO PRINCIPALE
               ============================ #}
            <h5>[ Photo principale ]</h5>
            {% set photo_principale = produit.medias|filter(m => m.role == 'photo_principale') %}
            {% if photo_principale is not empty %}
                <div class="photo-principale">
                    {% for media in photo_principale %}
                        <img src="{{ vich_uploader_asset(media, 'file') }}"
                             alt=""
                             style="max-width:10rem; margin:1rem;">
                    {% endfor %}
                </div>
            {% else %}
                <p>Aucune photo principale</p>
            {% endif %}
             
            <div class="description">{{ produit.description|replace({
                    '&nbsp;': ' ',
                    '<br>': "\n",
                    '</div>': "\n", 
                    '<div>': ''
                })|striptags|nl2br }}
            </div>
         
            {# ============================
               PHOTOS SUPPLÉMENTAIRES
               ============================ #}
             <h5>[ Photos supplémentaires ]</h3>
            {% set photos_supp = produit.medias|filter(m => m.role == 'photo_supplementaire') %}
            {% if photos_supp is not empty %}
                <div class="photos-supplementaires" style="display:flex; flex-wrap:wrap; gap:1rem; width:120rem;">
                    {% for media in photos_supp %}
                        <img src="{{ vich_uploader_asset(media, 'file') }}"
                             alt=""
                             style="width:10rem; height:10rem; margin:1rem; border-radius:1rem; object-fit:cover;">
                    {% endfor %}
                </div>
            {% else %}
                <p>Aucune photo supplémentaire</p>
            {% endif %}
             
            {# ============================
               PRODUCTEURICES
               ============================ #}
             <h5>[ Producteurices ]</h3>
            {% if produit.producteurices is empty %}
                <p>Aucun producteurice associé</p>
            {% else %}
                <ul>
                    {% for p in produit.producteurices %}
                        <li>
                            <strong>{{ p.nom }}</strong>
                            {% if p.site %}
                                — <a href="{{ p.site }}" target="_blank">Site web</a>
                            {% endif %}
                            {# Logos du producteurice #}
                            {% set logos = p.medias|filter(m => m.role == 'logo') %}
                            {% if logos|length > 0 %}
                                {% for logo in logos %}
                                    <img src="{{ vich_uploader_asset(logo, 'file') }}"
                                         alt="Logo de {{ p.nom }}"
                                         style="max-width:10rem; margin:1rem;">
                                {% endfor %}
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
             
            {# ============================
               FICHIERS
               ============================ #}
             <h5>[ Fichiers associés ]</h3>
            {% set fichiers = produit.medias|filter(m => m.role == 'fichier') %}
            {% if fichiers is empty %}
                <p>Aucun fichier associé</p>
            {% else %}
                <ul>
                    {% for media in fichiers %}
                        <li>
                            <a href="{{ asset('uploads/medias/' ~ media.nomFichier) }}" download>
                                {{ media.nomFichier }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
        <hr>
    {% else %}
        <p>Aucun produit trouvé</p>
    {% endfor %}

</div>
{% endblock %}
