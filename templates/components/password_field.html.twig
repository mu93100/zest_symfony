{# templates/components/password_field.html.twig #}

<div class="form-field">
    <label for="{{ id }}">{{ label }}</label>

    <div class="password-wrapper">
        <input
            type="password"
            id="{{ id }}"
            name="{{ field_name }}"
            required="{{ required|default(true) ? 'required' }}"
            autocomplete="{{ autocomplete|default('current-password') }}"
        >


        <button
            type="button"
            class="password-toggle"
            aria-label="Afficher le mot de passe"
            onclick="togglePasswordVisibility('{{ id }}', this)"
        >
            <img src="{{ asset('images/oeilOuvert.webp') }}" alt="" class="eye-icon">
        </button>
    </div>
</div>
