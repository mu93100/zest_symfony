{# templates/components/password_field.html.twig #}

{# 1) On unifie la gestion des erreurs #} 
{# - Si "errors" est passé (register), on l'utilise comme tableau d'erreurs Symfony - Si "hasError" booléen est passé (login), on l'utilise juste pour la classe CSS #} 
{% set errorsList = errors is defined ? errors : [] %} 
{% set hasErrorFlag = (errorsList|length > 0) or (hasError is defined and hasError) %} 

<div class="form-field">
    <label for="{{ id }}">{{ label }}</label>

    <div class="password-wrapper">
        <input
            type="password"
            id="{{ id }}"
            name="{{ field_name }}"
            required="{{ required|default(true) ? 'required' }}"
            autocomplete="{{ autocomplete|default('current-password') }}"
            class="form-input {{ hasErrorFlag ? 'is-invalid' : '' }}"
        >


        <button
            type="button"
            class="password-toggle"
            aria-label="Afficher le mot de passe"
            onclick="togglePasswordVisibility('{{ id }}', this)"
        >
            <img src="{{ asset('images/oeilOuvert.webp') }}" alt="" class="eye-icon">
        </button>
    </div>

    {# 2) Affichage conditionnel des messages d'erreur #} 
    {% if errorsList|length > 0 %} 
    <div class="invalid-feedback"> 
    {% for error in errorsList %} 
    {{ error.message }} {% endfor %} 
    </div> 
    {% elseif hasError is defined and hasError %} 
    {# Cas login : erreur globale email/mot de passe #} 
    <div class="invalid-feedback"> [ email ou mot de passe incorrect ] </div> 
    {% endif %}
</div>
