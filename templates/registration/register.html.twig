				});

				// si le user ecrit un nouveau groupe, ça deselectionne la liste
				nouveauGroupeField.addEventListener('input', function () {
					if (nouveauGroupeField.value.trim()) {		// trim => pour enlever les espaces
						groupeListe.value = '';
					}
				});
			}
		});
	</script>#}
{% endblock %}


