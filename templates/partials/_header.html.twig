<header>
  <div class="logo-header">
    <img src="/images/logo.png" alt="logo zest"> 
  </div>

  <div class="nav-header">
    {#   P I L L S   #}
    <div class="nav-pill">
      <div class="pill-group">
        <a class="pill" href="{{ path('app_register') }}">créer un compte</a>{#rejoindre le GAS vers p.fonctionnement#}
        <a class="pill" href="{{ path('app_adhesion') }}">adhérer</a>

        {% if app.user %}
            <a class="pill" href="/logout">déconnexion</a>
        {% else %}
            <a class="pill pill-black" href="/login">se connecter</a>
        {% endif %}
      </div>

      <div class="pill-group">
        <form method="get" action="{{ path('app_recherche') }}" class="search-form">
            <input
                type="search"
                name="q"
                class="pill pill-search-input"
                placeholder="rechercher"
                value="{{ searchQuery ?? app.request.get('q') }}"
            >
            <input type="submit" style="display: none;">
        </form>
        {# search avec Controller/SearchController.php + templates/search/index.html.twig #}

        <a class="pill" href="https://www.socleo.com/demandez-une-demo/">commander</a>
        {#<a class="pill" href="{{ path('faq') }}">F.A.Q</a>
        <a class="pill" href="{{ path('app_recettes') }}">recettes</a>#}
        <a class="pill" href="{#{{ path('forum') }}#}">forum</a>
        <a class="pill" href="{#{{ path('app_calendrier') }}#}">calendrier</a>
      </div>
    </div>

    {#   M E N U   #}
    <nav class="nav-nav-header">
      <ul>
        <li><a href="{{ path('app_accueil') }}">accueil</a></li>
        <li><a href="{#{{ path('app_fonctionnement') }}#}">fonctionnement</a></li>
        <li><a href="{#{{ path('app_ressources') }}#}">ressources</a></li>
        <li><a href="{#{{ path('app_producteurices') }}#}">producteur.ices</a></li>
