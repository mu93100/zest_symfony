{% extends 'base.html.twig' %}

{% block title %}Mon compte{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>M O N    C O M P T E </h1>

    {{ form_start(form) }}

    <div class="compte-form">

        {{ form_row(form.prenom) }}
        {{ form_row(form.nom) }}
        {{ form_row(form.email) }}
        {{ form_row(form.telephone) }}
        {{ form_row(form.adresse) }}
        {{ form_row(form.codePostal) }}
        {{ form_row(form.ville) }}
        {{ form_row(form.dateDeNaissance) }}
        {{ form_row(form.compositionFoyer) }}
        {{ form_row(form.nombreEnfants) }}

        <h2>Mon groupe</h2>
        {{ form_row(form.groupe) }}
        {{ form_row(form.nouveauGroupe) }}
        {{ form_row(form.isReferent) }}

        <h2>Changer mon mot de passe</h2>
        {{ form_row(form.newPassword) }}

    </div>

    <button class="btn">Mettre à jour</button>

    {{ form_end(form) }}

    
</div>
{% endblock %}